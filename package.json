{
  "name": "slidev-theme-calmecac",
  "version": "2.1.0",
  "description": "Official CALMÉCAC Brand Theme for Slidev",
  "author": "Rífatela",
  "license": "Apache-2.0",
  "type": "module",
  "main": "layouts/default.vue",
  "files": [
    "layouts",
    "components",
    "styles",
    "setup",
    "public",
    "assets",
    "uno.config.ts",
    "LICENSE"
  ],
  "keywords": [
    "slidev-theme",
    "slidev",
    "calmecac"
  ],
  "publishConfig": {
