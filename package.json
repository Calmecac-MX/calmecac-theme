    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.18.1",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@slidev/cli": "^52.18.1"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "transition": "fade-out"
    }
